mongo_export/**/_SUCCESS
mongo_export/**/._SUCCESS.crc

# General Hadoop/Spark output patterns
part-*.json
*.crc
_SUCCESS
._SUCCESS.crc
_temporary/

# HDFS local data directories (datanode / namenode volumes)
hdfs/datanode/
hdfs/namenode/

